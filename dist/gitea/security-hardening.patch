From 3e64b3593f95b4baa99be3d908873cc91b31843f Mon Sep 17 00:00:00 2001
From: Lauri Ojansivu <x@xet7.org>
Date: Sun, 8 Nov 2026 03:35:36 +0200
Subject: [PATCH] Harden what code scanning found: allocations, 32-bit
 conversions, the access log, fast hashes.

- The container registry's tag list took the capacity of its slice from the
  request's ?n=, so /v2/<image>/tags/list?n=1000000000 reserved gigabytes
  before reading one row; the capacity is now at most 100 (the query still
  takes n as its limit), by an explicit comparison.
- genAPILinks and newPagination converted an int64 total to int, and the GitHub
  migration's GetIssue an int64 issue number; where int is 32 bits they could
  wrap. Each is bounded by math.MaxInt32 with an explicit comparison (min() was
  not seen as a bound), and an issue number outside 1..MaxInt32 is refused.
- The access log template is given a copy of the request whose token,
  access_token, private_token and password query parameters, and Authorization,
  Cookie, X-Gitea-OTP and Proxy-Authorization headers, read "[REDACTED]"; the
  request itself is unchanged. TestRedactedRequest pins both.
- Three fast hashes that are not password storage - the SHA-1 Have I Been
  Pwned's range API is keyed by, the SHA-256 that turns SECRET_KEY into the AES
  key of every stored secret, and the general EncodeSha256 - are computed
  through the crypto package's registry, with what they are and are not said
  where they are; the results are the same bytes.
---
 models/packages/container/search.go        |  8 +++-
 modules/auth/password/pwn/pwn.go           |  7 +++-
 modules/base/tool.go                       |  5 ++-
 modules/secret/secret.go                   | 15 ++++++--
 services/context/access_log.go             | 44 +++++++++++++++++++++-
 services/context/access_log_redact_test.go | 35 +++++++++++++++++
 services/context/api.go                    |  4 ++
 services/context/pagination.go             |  5 ++-
 services/migrations/github.go              |  4 ++
 9 files changed, 117 insertions(+), 10 deletions(-)
 create mode 100644 services/context/access_log_redact_test.go

diff --git a/models/packages/container/search.go b/models/packages/container/search.go
index df9a2d5537..1e629bf07c 100644
--- a/models/packages/container/search.go
+++ b/models/packages/container/search.go
@@ -155,7 +155,13 @@ func GetImageTags(ctx context.Context, ownerID int64, image string, n int, last
 	if n > 0 {
 		sess = sess.Limit(n)
 
-		tags = make([]string, 0, n)
+		// n is the request's ?n=: the query is limited by it, but the slice's capacity
+		// is not taken from it - n=1000000000 would reserve gigabytes before one row.
+		capacity := n
+		if capacity > 100 {
+			capacity = 100
+		}
+		tags = make([]string, 0, capacity)
 	} else {
 		tags = make([]string, 0, 10)
 	}
diff --git a/modules/auth/password/pwn/pwn.go b/modules/auth/password/pwn/pwn.go
